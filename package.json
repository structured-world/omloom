{
  "name": "omloom-contracts-workspace",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "yarn generate && yarn build:app --outDir ../../var/development-ui && cargo run --locked -p omloom-app --bin omloom-dev -- --data var/development --ui var/development-ui --fixture operator",
    "start": "yarn dev",
    "generate": "protoc --proto_path=proto --plugin=protoc-gen-ts=node_modules/.bin/protoc-gen-ts --ts_out=web/src/generated --ts_opt=long_type_bigint,force_optimize_code_size,force_client_none proto/omloom/v1/contracts.proto proto/omloom/v1/workspace.proto",
    "typecheck": "tsc --noEmit",
    "build": "tsc && esbuild web/src/browser-corpus.ts --bundle --format=iife --outfile=dist/browser-corpus.js",
    "test:contracts": "node --test web/tests/contracts.test.mjs web/tests/presentation.test.mjs web/tests/field-host.test.mjs",
    "test:browser": "playwright test",
    "clean": "node scripts/clean.mjs",
    "build:app": "node scripts/check-vue.cjs --noEmit -p web/app/tsconfig.json && vite build --config web/app/vite.config.ts"
  },
  "dependencies": {
    "@protobuf-ts/grpcweb-transport": "2.11.1",
    "@protobuf-ts/runtime": "2.11.1",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@protobuf-ts/plugin": "2.11.1",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "typescript-vue": "npm:typescript@6.0.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
